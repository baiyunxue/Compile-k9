# ===================== 硬件平台设置 XR30‑EMMC(RAX3000M‑EMMC) MT7981B =====================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000m-emmc=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_cmcc_rax3000m-emmc=""
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_xr30-emmc=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_cmcc_xr30-emmc=""

# eMMC根分区大小
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_TARGET_ROOTFS_EMMC=y

# Busybox基础功能
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SYSLOG=y

# ===================== 文件系统支持 =====================
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_resize2fs=y

# ===================== USB驱动(USB3.0 + 4G上网猫支持usbmodem) =====================
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_ntfs3-mount=y
# 4G USB Modem全套
CONFIG_PACKAGE_luci-app-usbmodem=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y

# ===================== 基础网络组件 =====================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-zh-cn=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-lib-fs=y

# dnsmasq完整版本
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq=n

# nftables防火墙全套
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables=y

# 下载工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_openssl-util=y

# TUN驱动 OpenClash强制依赖
CONFIG_PACKAGE_kmod-tun=y

# ===================== WiFi MT79xx闭源驱动（补丁生效后才可见） =====================
#CONFIG_PACKAGE_kmod-mt79xx=y
#CONFIG_PACKAGE_wpad-openssl=y
#CONFIG_PACKAGE_hostapd-common=y

# ===================== 系统自带基础luci应用 =====================
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-system=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

# samba 轻量版，放弃samba4
CONFIG_PACKAGE_luci-app-samba=y
CONFIG_PACKAGE_samba36-server=y

CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y

# vsftpd FTP服务
CONFIG_PACKAGE_vsftpd=y
CONFIG_PACKAGE_luci-app-vsftpd=y

# aria2下载
CONFIG_PACKAGE_aria2=y
CONFIG_PACKAGE_luci-app-aria2=y

# hd‑idle硬盘休眠
CONFIG_PACKAGE_hd-idle=y
CONFIG_PACKAGE_luci-app-hd-idle=y

# vlmcsd KMS激活服务
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y

# ===================== 用户自定义第三方插件清单（全部按你的需求） =====================
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-app-linkease=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-unblockneteasemusic=y
# iStore商店(store)
CONFIG_PACKAGE_luci-app-store=y

# ===================== 有线AP智能漫游 usteer =====================
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_luci-app-usteer=y

# ===================== Web管理主题 =====================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap-mod=y

# ===================== Docker依赖库 =====================
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-ipt-extra=y

# ===================== 时区时间同步 =====================
CONFIG_PACKAGE_ntpclient=y
CONFIG_PACKAGE_zoneinfo-asia-shanghai=y

# EMMC必需模块
CONFIG_PACKAGE_kmod-mmc=y

# PPPoE拨号支持
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_pppoe=y

# SSL库
CONFIG_LIBCURL_OPENSSL=y
CONFIG_ZLIB_OPTIMIZE=y

# 关闭调试输出，减小固件体积
CONFIG_DEBUG=n
