# ===================== 目标硬件平台设置 =====================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7622=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_mediatek_mt7622_DEVICE_cmcc_xr30_emmc=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_mt7622_DEVICE_cmcc_xr30_emmc=""

# 根分区大小，docker和AdGuardHome占用空间较大，设置2048MB
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_TARGET_ROOTFS_EMMC=y

# Busybox基础功能开启
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SYSLOG=y

# ===================== 文件系统支持 =====================
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_resize2fs=y

# ===================== USB存储相关驱动 =====================
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-uhci=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_ntfs3-mount=y

# ===================== 基础网络组件 =====================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-zh-cn=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-lib-fs=y

# 使用完整版dnsmasq，替换精简版
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq=n

# ip、iptables防火墙全套支持
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables=y

# 网络下载工具
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_openssl-util=y

# ===================== WiFi MTK闭源驱动【重要】 =====================
CONFIG_PACKAGE_kmod-mt_wifi=y
# !!!! 禁止开启开源mt76系列驱动，禁止打开kmod‑mt7615e，会造成驱动冲突无线失效
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_hostapd-common=y

# ===================== Luci系统自带基础功能 =====================
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-system=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y

# ===================== PassWall2代理套件 =====================
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_passwall2-core=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_trojan-plus=y
CONFIG_PACKAGE_v2ray-core=n
CONFIG_PACKAGE_shadowsocks-libev-ss-local=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y

# ===================== 用户自定义第三方LuCI插件 =====================
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-dockerman=y
# EasyMesh已经禁用；闭源驱动不支持无线Mesh，改用有线AP+802.11kvr漫游
#CONFIG_PACKAGE_luci-app-easymesh=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-linkease=y
# OpenClash代理已注释关闭，和PassWall2二选一，不要同时启用
#CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-usbmodem=y
CONFIG_PACKAGE_luci-app-unblockneteasemusic=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-app-vsftpd=y

# ===================== 802.11k/v/r 有线AP智能漫游 =====================
CONFIG_PACKAGE_luci-app-steering=y
CONFIG_PACKAGE_luci-app-wifi-assistant=y

# ===================== Web管理界面主题 =====================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap-mod=y

# ===================== Docker运行依赖库 =====================
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-ipt-extra=y

# ===================== 时区与时间同步 =====================
CONFIG_PACKAGE_ntpclient=y
CONFIG_PACKAGE_zoneinfo-asia=y

# ===================== EMMC闪存必需驱动模块 =====================
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mtk-emmc=y

# LED指示灯控制插件
CONFIG_PACKAGE_luci-app-led-control=y

# 开启PPPOE拨号支持，家用宽带拨号需要
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_pppoe=y

# 网络SSL库配置
CONFIG_LIBCURL_OPENSSL=y
CONFIG_ZLIB_OPTIMIZE=y

# 关闭调试输出，减小固件体积
CONFIG_DEBUG=n
CONFIG_KERNEL_DEBUG=n
